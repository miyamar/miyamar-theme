{
  "name": "miyamar-theme",
  "displayName": "Miyamar Theme",
  "description": "A minimal well-focused theme crafted for deep work, clear code, and effortless flow—designed to make long coding sessions feel productive and more enjoyable.",
  "version": "1.5.0",
  "author": "Hasnain Izhar",
  "publisher": "miyamar",
  "icon": "images/icon.png",
  "repository": "https://github.com/miyamar/miyamar-theme.git",
  "engines": {
    "vscode": "^1.85.0"
  },
  "scripts": {
    "build": "npm run build:zed",
    "build:zed": "node scripts/build-zed.mjs"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Miyamar Dark",
        "type": "dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-color-theme.json"
      },
      {
        "label": "Miyamar Light",
        "type": "light",
        "uiTheme": "vs",
        "path": "./themes/light-color-theme.json"
      },
      {
        "label": "Miyamar Pink (Baby Girl Wished)",
        "type": "light",
        "uiTheme": "vs",
        "path": "./themes/pink-milky-theme.json"
      },
      {
        "label": "Miyamar Burgundy (Dark)",
        "type": "dark",
        "uiTheme": "vs-dark",
        "path": "./themes/burgundy-dark-theme.json"
      },
      {
        "label": "Miyamar Burgundy (Light)",
        "type": "light",
        "uiTheme": "vs",
        "path": "./themes/burgundy-light-theme.json"
      }
    ]
  }
}
